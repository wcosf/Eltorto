{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=eltorto_pg;Username=postgres;Password=${DB_PASSWORD}"
  },
  "JwtSettings": {
    "SecretKey": "${JWT_SECRET}",
    "Issuer": "EltortoAPI",
    "Audience": "EltortoClient"
  },
    "AdminSettings": {
    "Password": "${ADMIN_PASSWORD}"
  },
  "UploadSettings": {
    "BasePath": "storage",
    "FillingsSubPath": "fillings",
    "CakesSubPath": "cakes",
    "SliderSubPath": "slider",
    "PagesSubPath": "pages"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost",
      "http://localhost:80",
      "https://eltorto.ru",
      "https://www.eltorto.ru"
    ]
  }
}
